{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "interactive",
  "homepage": "https://interactive.net.pl",
  "items": [
    {
      "name": "brand",
      "type": "registry:base",
      "title": "Interactive brand foundation",
      "description": "Kolory marki, gradienty, zmienne CSS, fonty i konfiguracja Tailwind dla ekosystemu Interactive Apps.",
      "style": "new-york",
      "baseColor": "zinc",
      "iconLibrary": "lucide",
      "dependencies": ["tailwindcss-animate"],
      "files": [
        {
          "path": "registry/default/brand/theme.css",
          "type": "registry:theme"
        }
      ],
      "cssVars": {
        "light": {
          "brand-violet": "#af14f7",
