          "muted": "240 3.7% 15.9%",
          "muted-foreground": "240 5% 64.9%",
          "accent": "240 3.7% 15.9%",
          "accent-foreground": "0 0% 98%",
          "destructive": "0 62.8% 30.6%",
          "destructive-foreground": "0 0% 98%",
          "border": "240 3.7% 15.9%",
          "input": "240 3.7% 15.9%",
          "ring": "271 81% 56%",
          "chart-1": "220 70% 50%",
