{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@/*": ["registry/default/*"],
      "@/components/*": ["registry/default/components/*"],
      "@/hooks/*": ["registry/default/hooks/*"],
      "@/lib/*": ["registry/default/lib/*"],
      "@/components/ui/*": ["registry/default/ui/*"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.tsx"]
}
